# ── Python artefacts ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# ── Pytest / test output ─────────────────────────────────────────────────
.pytest_cache/
.cache/
*.log

# ── Reports (HTML generated at runtime — not committed) ──────────────────
reports/*.html
reports/*.xml

# ── Screenshots (runtime artefacts — not committed) ──────────────────────
reports/screenshots/*.png

# ── Excel test data ──────────────────────────────────────────────────────
# validdata.xlsx is fetched from the artifact bucket at runtime.
validdata.xlsx

# ── IDE ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
